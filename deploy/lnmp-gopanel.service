[Unit]
Description=LNMP GoPanel real-time monitoring
After=network.target

[Service]
Type=simple
User=lnmp-panel
Group=lnmp-panel
ExecStart=/usr/local/bin/lnmp-gopanel
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
StateDirectory=lnmp-gopanel
StateDirectoryMode=0700
# sudo must be able to elevate only the fixed helper. On systemd versions such
# as 252, the four settings below implicitly enable NoNewPrivileges for User=.
# Setting NoNewPrivileges=false alone does not override those implications.
# Do not enable RestrictSUIDSGID either. /proc stays visible for host metrics.
# LNMP init scripts and nginx -t need access to /usr/local and /home.
# The sudo helper inherits this unit namespace; do not mask these paths.
NoNewPrivileges=false
ProtectKernelTunables=false
ProtectKernelModules=false
ProtectControlGroups=true
RestrictRealtime=false
LockPersonality=false
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
