# Install root:root 0440 to /etc/sudoers.d/lnmp-gopanel, validate with visudo.
# Each exact service/action pair is listed; do not replace with wildcard args.
Defaults:lnmp-panel !requiretty
Cmnd_Alias LNMP_PANEL = /usr/local/libexec/lnmp-gopanel-control nginx status, \
 /usr/local/libexec/lnmp-gopanel-control docker snapshot, \
 /usr/local/libexec/lnmp-gopanel-control redis status, \
 /usr/local/libexec/lnmp-gopanel-control nginx start, \
 /usr/local/libexec/lnmp-gopanel-control nginx stop, \
 /usr/local/libexec/lnmp-gopanel-control nginx restart, \
 /usr/local/libexec/lnmp-gopanel-control nginx reload, \
 /usr/local/libexec/lnmp-gopanel-control php-fpm status, \
 /usr/local/libexec/lnmp-gopanel-control php-fpm start, \
 /usr/local/libexec/lnmp-gopanel-control php-fpm stop, \
 /usr/local/libexec/lnmp-gopanel-control php-fpm restart, \
 /usr/local/libexec/lnmp-gopanel-control mysql status, \
 /usr/local/libexec/lnmp-gopanel-control mysql start, \
 /usr/local/libexec/lnmp-gopanel-control mysql stop, \
 /usr/local/libexec/lnmp-gopanel-control mysql restart, \
 /usr/local/libexec/lnmp-gopanel-control mariadb status, \
 /usr/local/libexec/lnmp-gopanel-control mariadb start, \
 /usr/local/libexec/lnmp-gopanel-control mariadb stop, \
 /usr/local/libexec/lnmp-gopanel-control mariadb restart, \
 /usr/local/libexec/lnmp-gopanel-control storage scan, \
 /usr/local/libexec/lnmp-gopanel-control vhosts list, \
 /usr/local/libexec/lnmp-gopanel-control vhosts config, \
 /usr/local/libexec/lnmp-gopanel-control vhosts usage, \
 /usr/local/libexec/lnmp-gopanel-control vhosts toggle
lnmp-panel ALL=(root) NOPASSWD: LNMP_PANEL
