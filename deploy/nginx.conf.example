# Adjust domain, certificate paths and the panel's installed HTTPS port (39481
# below is only an example). Configure public_origin
# in /etc/lnmp-gopanel/config.yaml before accessing the HTTPS origin.
# For an imported CA-issued upstream certificate, replace panel.crt below with
# the CA trust bundle (for example /etc/ssl/certs/ca-certificates.crt).
server {
    listen 443 ssl;
    server_name panel.example.com;
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass https://127.0.0.1:39481;
        proxy_ssl_trusted_certificate /etc/lnmp-gopanel/tls/panel.crt;
        proxy_ssl_verify on;
        proxy_ssl_server_name on;
        proxy_ssl_name localhost; # For an imported certificate, use its DNS name.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/metrics/stream {
        proxy_pass https://127.0.0.1:39481;
        proxy_ssl_trusted_certificate /etc/lnmp-gopanel/tls/panel.crt;
        proxy_ssl_verify on;
        proxy_ssl_server_name on;
        proxy_ssl_name localhost;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 60s;
    }
}
